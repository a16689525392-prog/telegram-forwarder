# 复制本文件为 .env 并填写真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交到仓库

# Telegram API 凭证，从 https://my.telegram.org 获取
API_ID=your_api_id
API_HASH=your_api_hash

# 机器人 Token，从 @BotFather 获取
BOT_TOKEN=your_bot_token

# 代理配置（可选，三项都填写才会启用）
# 例如：PROXY_TYPE=http  PROXY_HOST=127.0.0.1  PROXY_PORT=7890
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
